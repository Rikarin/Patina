version: 1
name: Water Drops
nodes:
  - { id: 1, type: Sub-graph/Input, x: -320, y: -400 }
  - { id: 2, type: Source/Mesh Map, x: -1280, y: 0, texts: { Map: position } }
  - { id: 3, type: Source/Volume Noise, x: -960, y: 0, values: { Octaves: [1] }, texts: { Basis: Worley, '=Scale': '6f + density * 40f', '=Seed': seed } }
  - { id: 4, type: Source/Volume Noise, x: -960, y: 200, values: { Octaves: [2] }, texts: { Basis: Gradient, '=Scale': '12f + density * 60f', '=Seed': 'seed + 1' } }
  - id: 5
    type: Filters/Pixel Processor
    x: -640
    y: 0
    texts:
      Expression: 'float4(smoothstep(x * (0.4f + b.x) + 0.02f, x * (0.4f + b.x) * 0.5f, a.x), saturate(1f - a.x / max(x * (0.4f + b.x), 0.001f)), 0f, 1f)'
      '=X': '0.05f + size * 0.3f'
  - id: 6
    type: Filters/Pixel Processor
    x: 0
    y: -400
    texts:
      Expression: 'float4(a.xyz * (1f - b.x * x * 0.5f), 1f)'
      '=X': wetness
  - id: 7
    type: Filters/Pixel Processor
    x: 0
    y: -240
    texts:
      Expression: 'float4(lerp(a.xyz, float3(0.03f, 0.03f, 0.03f), b.x * x), 1f)'
      '=X': wetness
  - id: 8
    type: Filters/Pixel Processor
    x: 0
    y: -80
    texts:
      Expression: 'float4(a.xyz + sqrt(b.y) * b.x * x * 0.04f, 1f)'
      '=X': bulge
  - { id: 99, type: Sub-graph/Output, x: 320, y: -240 }
edges:
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: Position }
  - { fromNode: 2, fromPort: Out, toNode: 4, toPort: Position }
  - { fromNode: 3, fromPort: Out, toNode: 5, toPort: A }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: B }
  - { fromNode: 1, fromPort: baseColor, toNode: 6, toPort: A }
  - { fromNode: 5, fromPort: Out, toNode: 6, toPort: B }
  - { fromNode: 1, fromPort: roughness, toNode: 7, toPort: A }
  - { fromNode: 5, fromPort: Out, toNode: 7, toPort: B }
  - { fromNode: 1, fromPort: height, toNode: 8, toPort: A }
  - { fromNode: 5, fromPort: Out, toNode: 8, toPort: B }
  - { fromNode: 6, fromPort: Out, toNode: 99, toPort: baseColor }
  - { fromNode: 7, fromPort: Out, toNode: 99, toPort: roughness }
  - { fromNode: 8, fromPort: Out, toNode: 99, toPort: height }
groups: []
comments: []
interface:
  - { name: baseColor, direction: Input, kind: Image, default: [], summary: 'The surface beneath, which a drop darkens as water does.' }
  - { name: roughness, direction: Input, kind: Image, default: [], summary: 'The roughness beneath, which a drop makes glossy.' }
  - { name: height, direction: Input, kind: Image, default: [], summary: 'The height beneath, which a drop domes.' }
  - { name: baseColor, direction: Output, kind: Image, default: [], summary: 'The surface, darker under every drop.' }
  - { name: roughness, direction: Output, kind: Image, default: [], summary: 'The roughness, glass-smooth on every drop.' }
  - { name: height, direction: Output, kind: Image, default: [], summary: 'The height, with a low dome for every drop.' }
settings:
  baseWidth: '1024'
  baseHeight: '1024'
  seed: '1'
  summary: 'Beads of water standing on the surface: glossy, darkening and domed, scattered through the model''s own space so they cross seams whole.'
  doesNotTile: 'Reads a mesh map, and an atlas has islands at its edges rather than a far side.'
parameters:
  - { name: density, label: Density, default: '0.4', summary: 'How many drops there are.', kind: Float, minimum: 0, maximum: 1, group: Drops }
  - { name: size, label: Size, default: '0.6', summary: 'How big a drop is, against the space between drops.', kind: Float, minimum: 0, maximum: 1, group: Drops }
  - { name: seed, label: Seed, default: '0', summary: 'Another draw of the drops. Every whole number is a different pattern.', kind: Int, minimum: 0, maximum: 100, group: Drops }
  - { name: wetness, label: Wetness, default: '0.8', summary: 'How glossy and dark a drop is.', kind: Float, minimum: 0, maximum: 1, group: Look }
  - { name: bulge, label: Bulge, default: '0.5', summary: 'How much a drop stands up from the surface.', kind: Float, minimum: 0, maximum: 1, group: Look }
