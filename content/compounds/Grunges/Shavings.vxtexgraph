version: 1
name: Shavings
nodes:
  - id: 1
    type: Source/Shape
    x: 0
    y: 0
    values:
      Inner: [0.05]
      Falloff: [0.03]
      Scale: [0.95]
    texts:
      'Kind': 'Crescent'
  - id: 2
    type: Placement/Splatter
    x: 300
    y: 0
    values:
      'Scale Jitter': [0.6]
      'Rotation Jitter': [6.2831855]
      'Colour Jitter': [0.5]
    texts:
      'Accumulation': 'Max'
      '=Count': '60f + amount * 340f'
      '=Scale': '0.2f - scale * 0.1f'
  - id: 3
    type: Source/Noise
    x: 0
    y: 300
    values:
      Octaves: [2]
    texts:
      'Basis': 'Gradient'
      '=Scale': '8f'
  - id: 4
    type: Filters/Warp
    x: 600
    y: 0
    values:
      Intensity: [3]
    texts: {}
  - id: 99
    type: Sub-graph/Output
    x: 1600
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Pattern }
  - { fromNode: 2, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Warp }
  - { fromNode: 4, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'Curled slivers turned off metal or wood, lying every which way. White is a sliver.'
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1' }
parameters:
  - name: scale
    default: '0.5'
    summary: 'How large the features are: low is fewer, bigger ones, high is many small ones.'
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
  - name: amount
    default: '0.5'
    summary: 'How much of the surface the grunge covers.'
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
