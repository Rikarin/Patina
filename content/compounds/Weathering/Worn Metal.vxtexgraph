version: 1
name: Worn Metal
nodes:
  - { id: 1, type: Sub-graph/Input, x: -320, y: -560 }
  - { id: 2, type: Source/Mesh Map, x: -1600, y: 0, texts: { Map: curvature } }
  - { id: 3, type: Filters/Blur HQ, x: -1280, y: 0, values: { Sigma: [1] } }
  - { id: 4, type: Colour/Histogram Equalise, x: -960, y: 0 }
  - { id: 5, type: Source/Mesh Map, x: -1600, y: 200, texts: { Map: ao } }
  - { id: 6, type: Source/Mesh Map, x: -1600, y: 400, texts: { Map: position } }
  - { id: 7, type: Source/Volume Noise, x: -1280, y: 400, values: { Octaves: [5], Gain: [0.6] }, texts: { Basis: Gradient, '=Scale': scale, '=Seed': seed } }
  - id: 8
    type: Filters/Pixel Processor
    x: -640
    y: 0
    texts:
      Expression: 'float4(smoothstep(0.97f - x * 0.3f, 1f - x * 0.12f, a.x), saturate(smoothstep(0.3f, 0.02f, a.x) * 0.6f + (1f - b.x) * 1.4f), 0f, 1f)'
      '=X': wear
  - id: 9
    type: Filters/Pixel Processor
    x: -320
    y: 0
    texts:
      Expression: 'float4(a.x * saturate(1f - (0.6f - b.x) * 3f), saturate(a.y * (0.4f + b.x) * x * 1.5f), b.x, 1f)'
      '=X': grime
  - id: 10
    type: Filters/Pixel Processor
    x: 320
    y: -560
    texts:
      Expression: 'float4(lerp(lerp(a.xyz * (1f - x * 0.3f * (1f - b.z)), saturate(a.xyz * 1.25f + 0.12f), b.x), a.xyz * 0.35f + float3(0.05f, 0.04f, 0.03f), b.y * 0.85f), 1f)'
      '=X': tarnish
  - id: 11
    type: Filters/Pixel Processor
    x: 320
    y: -400
    texts:
      Expression: 'float4(saturate(lerp(lerp(a.xyz + (b.z - 0.4f) * x * 0.3f, a.xyz * 0.45f, b.x), float3(0.85f, 0.85f, 0.85f), b.y)), 1f)'
      '=X': tarnish
  - id: 12
    type: Filters/Pixel Processor
    x: 320
    y: -240
    texts:
      Expression: 'float4(lerp(lerp(a.xyz, float3(1f, 1f, 1f), b.x), float3(0f, 0f, 0f), b.y), 1f)'
  - id: 13
    type: Filters/Pixel Processor
    x: 320
    y: -80
    texts:
      Expression: 'float4(a.xyz + b.y * 0.02f - b.x * 0.01f, 1f)'
  - { id: 99, type: Sub-graph/Output, x: 640, y: -320 }
edges:
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 6, fromPort: Out, toNode: 7, toPort: Position }
  - { fromNode: 4, fromPort: Out, toNode: 8, toPort: A }
  - { fromNode: 5, fromPort: Out, toNode: 8, toPort: B }
  - { fromNode: 8, fromPort: Out, toNode: 9, toPort: A }
  - { fromNode: 7, fromPort: Out, toNode: 9, toPort: B }
  - { fromNode: 1, fromPort: baseColor, toNode: 10, toPort: A }
  - { fromNode: 9, fromPort: Out, toNode: 10, toPort: B }
  - { fromNode: 1, fromPort: roughness, toNode: 11, toPort: A }
  - { fromNode: 9, fromPort: Out, toNode: 11, toPort: B }
  - { fromNode: 1, fromPort: metalness, toNode: 12, toPort: A }
  - { fromNode: 9, fromPort: Out, toNode: 12, toPort: B }
  - { fromNode: 1, fromPort: height, toNode: 13, toPort: A }
  - { fromNode: 9, fromPort: Out, toNode: 13, toPort: B }
  - { fromNode: 10, fromPort: Out, toNode: 99, toPort: baseColor }
  - { fromNode: 11, fromPort: Out, toNode: 99, toPort: roughness }
  - { fromNode: 12, fromPort: Out, toNode: 99, toPort: metalness }
  - { fromNode: 13, fromPort: Out, toNode: 99, toPort: height }
groups: []
comments: []
interface:
  - { name: baseColor, direction: Input, kind: Image, default: [], summary: 'The painted or coated surface over the metal.' }
  - { name: roughness, direction: Input, kind: Image, default: [], summary: 'The roughness beneath.' }
  - { name: metalness, direction: Input, kind: Image, default: [], summary: 'The metalness beneath: nought for a painted coat.' }
  - { name: height, direction: Input, kind: Image, default: [], summary: 'The height beneath.' }
  - { name: baseColor, direction: Output, kind: Image, default: [], summary: 'The surface worn through to bright metal on its edges, grimy in its hollows and dulled unevenly between.' }
  - { name: roughness, direction: Output, kind: Image, default: [], summary: 'The roughness, polished where hands and tools wore it and rough where grime sits.' }
  - { name: metalness, direction: Output, kind: Image, default: [], summary: 'The metalness, bare metal on the worn edges and none under the grime.' }
  - { name: height, direction: Output, kind: Image, default: [], summary: 'The height, a little lower where it wore and higher where grime built up.' }
settings:
  baseWidth: '1024'
  baseHeight: '1024'
  seed: '1'
  summary: 'Worn metal: a coat rubbed through to bright metal on the edges, grime packed into the hollows and a tarnish that dulls it unevenly, in every channel at once.'
  doesNotTile: 'Reads mesh maps, and an atlas has islands at its edges rather than a far side.'
parameters:
  - { name: wear, label: Edge Wear, default: '0.5', summary: 'How far the coat is worn through on the edges.', kind: Float, minimum: 0, maximum: 1, group: Wear }
  - { name: grime, label: Grime, default: '0.5', summary: 'How much grime sits in the hollows and creases.', kind: Float, minimum: 0, maximum: 1, group: Wear }
  - { name: tarnish, label: Tarnish, default: '0.4', summary: 'How unevenly the whole surface has dulled.', kind: Float, minimum: 0, maximum: 1, group: Wear }
  - { name: scale, label: Breakup Scale, default: '6', summary: 'How many patches the wear and grime break into across the model.', kind: Float, minimum: 1, maximum: 32, group: Breakup }
  - { name: seed, label: Seed, default: '0', summary: 'Another draw of the breakup. Every whole number is a different pattern.', kind: Int, minimum: 0, maximum: 100, group: Breakup }
