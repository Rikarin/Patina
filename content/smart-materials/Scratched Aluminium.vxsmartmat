version: 1
name: Scratched Aluminium
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: aluminium
        name: Aluminium
        kind: Fill
        values:
          baseColor: [0.91, 0.92, 0.92, 1]
          roughness: [0.32, 0.32, 0.32, 1]
          metalness: [1, 1, 1, 1]
      - id: scratches
        name: Scratches
        kind: Fill
        blend: Copy
        values:
          baseColor: [0.95, 0.95, 0.95, 1]
          roughness: [0.18, 0.18, 0.18, 1]
          metalness: [1, 1, 1, 1]
        mask:
          source: Generator
          generator: Generators/Surface Scratches
      - id: smudges
        name: Smudges
        kind: Fill
        blend: Copy
        opacity: 0.5
        values:
          baseColor: [0.86, 0.86, 0.86, 1]
          roughness: [0.5, 0.5, 0.5, 1]
          metalness: [1, 1, 1, 1]
        mask:
          source: Generator
          generator: Grunges/Smudges
      - id: dust
        name: Dust
        kind: Fill
        blend: Copy
        opacity: 0.5
        values:
          baseColor: [0.55, 0.53, 0.5, 1]
          roughness: [0.9, 0.9, 0.9, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Cavity Select
