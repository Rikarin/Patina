version: 1
name: Direction
nodes:
  - { id: 1, type: Source/Mesh Map, x: -640, y: 0, texts: { Map: world } }
  - id: 2
    type: Filters/Pixel Processor
    x: -320
    y: 0
    texts:
      Format: Grey
      Expression: 'float4(dot(a.xyz * 2f - 1f, normalize(float3(x, y, z) + 0.00001f)) * 0.5f + 0.5f, 0f, 0f, 1f)'
      '=X': across
      '=Y': up
      '=Z': through
  - id: 3
    type: Colour/Levels
    x: 0
    y: 0
    texts:
      '=Input Black': '1f - spread - softness * 0.25f'
      '=Input White': '1f - spread + softness * 0.25f + 0.001f'
  - { id: 99, type: Sub-graph/Output, x: 320, y: 0 }
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: A }
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'White on every face turned towards the direction, fading out as a face turns away.'
settings:
  baseWidth: '1024'
  baseHeight: '1024'
  seed: '1'
  summary: 'The faces of the model that point one way in its own space: the tops for snow or dust, one side for weather.'
  doesNotTile: 'Reads a mesh map, and an atlas has islands at its edges rather than a far side.'
parameters:
  - { name: across, label: Across, default: '0', summary: 'How much the direction points along the model''s first axis. Negative is the other way.', kind: Float, minimum: -1, maximum: 1, group: Direction }
  - { name: up, label: Up, default: '1', summary: 'How much it points up the model. Negative points down.', kind: Float, minimum: -1, maximum: 1, group: Direction }
  - { name: through, label: Through, default: '0', summary: 'How much it points through the model, front to back.', kind: Float, minimum: -1, maximum: 1, group: Direction }
  - { name: spread, label: Spread, default: '0.3', summary: 'How far a face may turn away and still count. A half takes every face on that side.', kind: Float, minimum: 0, maximum: 1, group: Selection }
  - { name: softness, label: Softness, default: '0.3', summary: 'How gently the selection fades out as a face turns away.', kind: Float, minimum: 0, maximum: 1, group: Selection }
