<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>REST API for Patina. It owns all domain state and talks to patina-worker over IPC. Nothing in the API depends on Electron: it starts with `patina-server --library path` and needs nothing else (plan §8).</Description>
    <AssemblyName>patina-server</AssemblyName>
    <RootNamespace>Patina.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Patina.Contracts/Patina.Contracts.csproj"/>
    <ProjectReference Include="../Patina.Ipc/Patina.Ipc.csproj"/>
    <ProjectReference Include="../Patina.Library/Patina.Library.csproj"/>
  </ItemGroup>
</Project>
