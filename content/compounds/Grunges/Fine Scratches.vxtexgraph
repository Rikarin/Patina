version: 1
name: Fine Scratches
nodes:
  - { id: 1, type: Source/Shape, x: 0, y: 0, values: { Inner: [0.02], Falloff: [0.04], Scale: [0.95] }, texts: { Kind: Capsule } }
  - id: 2
    type: Placement/Splatter
    x: 300
    y: 0
    values: { Scale Jitter: [0.6], Rotation Jitter: [6.2831855], Colour Jitter: [0.7] }
    texts: { Accumulation: Max, '=Count': '120f + amount * 600f', '=Scale': '0.22f - scale * 0.12f' }
  - { id: 3, type: Source/Noise, x: 0, y: 300, values: { Octaves: [3], Gain: [0.5] }, texts: { Basis: Gradient, '=Scale': '4f' } }
  - id: 4
    type: Filters/Pixel Processor
    x: 600
    y: 0
    texts:
      Format: Grey
      Expression: 'float4(a.x * (0.35f + 0.65f * smoothstep(0.25f, 0.75f, b.x)), 0f, 0f, 1f)'
  - { id: 99, type: Sub-graph/Output, x: 900, y: 0 }
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Pattern }
  - { fromNode: 2, fromPort: Out, toNode: 4, toPort: A }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: B }
  - { fromNode: 4, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - { name: Out, direction: Output, kind: Image, default: [], summary: 'Hairline scratches in every direction, as daily handling leaves on paint, plastic or polished metal. White is a scratch.' }
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1' }
parameters:
  - { name: scale, label: Scale, default: '0.5', summary: 'How large the features are: low is fewer, bigger ones, high is many small ones.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
  - { name: amount, label: Amount, default: '0.5', summary: 'How much of the surface the grunge covers.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
