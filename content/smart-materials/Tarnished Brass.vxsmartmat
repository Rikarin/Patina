version: 1
name: Tarnished Brass
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: brass
        name: Brass
        kind: Fill
        values:
          baseColor: [0.9, 0.75, 0.42, 1]
          roughness: [0.28, 0.28, 0.28, 1]
          metalness: [1, 1, 1, 1]
      - id: tarnish
        name: Tarnish
        kind: Fill
        blend: Copy
        opacity: 0.7
        values:
          baseColor: [0.38, 0.3, 0.16, 1]
          roughness: [0.6, 0.6, 0.6, 1]
          metalness: [0.7, 0.7, 0.7, 1]
        mask:
          source: Generator
          generator: Grunges/Dirt Patches
      - id: grime
        name: Grime
        kind: Fill
        blend: Copy
        opacity: 0.8
        values:
          baseColor: [0.14, 0.12, 0.08, 1]
          roughness: [0.8, 0.8, 0.8, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Cavity Select
      - id: polish
        name: Polish
        kind: Fill
        blend: Copy
        values:
          baseColor: [0.95, 0.82, 0.5, 1]
          roughness: [0.15, 0.15, 0.15, 1]
          metalness: [1, 1, 1, 1]
        mask:
          source: Generator
          generator: Generators/Edge Select
          effects:
            - node: Colour/Levels
              values:
                Input Black: [0.4]
                Input White: [0.9]
