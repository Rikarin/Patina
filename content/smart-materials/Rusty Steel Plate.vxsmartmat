version: 1
name: Rusty Steel Plate
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: steel
        name: Steel
        kind: Fill
        values:
          baseColor: [0.53, 0.54, 0.55, 1]
          roughness: [0.45, 0.45, 0.45, 1]
          metalness: [1, 1, 1, 1]
      - id: pitting
        name: Pitting
        kind: Fill
        blend: Copy
        opacity: 0.7
        values:
          baseColor: [0.38, 0.38, 0.38, 1]
          roughness: [0.7, 0.7, 0.7, 1]
          metalness: [0.8, 0.8, 0.8, 1]
        mask:
          source: Generator
          generator: Grunges/Pitted Steel
      - id: rust
        name: Rust
        kind: Fill
        blend: Copy
        values:
          baseColor: [0.4, 0.18, 0.07, 1]
          roughness: [0.9, 0.9, 0.9, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Grunges/Rust Spots
      - id: runs
        name: Rust Runs
        kind: Fill
        blend: Copy
        opacity: 0.7
        values:
          baseColor: [0.45, 0.2, 0.08, 1]
          roughness: [0.85, 0.85, 0.85, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Drips
      - id: edges
        name: Bright Edges
        kind: Fill
        blend: Copy
        values:
          baseColor: [0.62, 0.63, 0.64, 1]
          roughness: [0.3, 0.3, 0.3, 1]
          metalness: [1, 1, 1, 1]
        mask:
          source: Generator
          generator: Generators/Edge Select
          effects:
            - node: Colour/Levels
              values:
                Input Black: [0.5]
                Input White: [0.95]
