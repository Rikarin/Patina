<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>REST API for Patina. It owns all domain state and talks to patina-worker over IPC. Nothing in the API depends on Electron: it starts with `patina-server --library path` and needs nothing else (plan §8).</Description>
    <AssemblyName>patina-server</AssemblyName>
    <RootNamespace>Patina.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Patina.Content/Patina.Content.csproj"/>
    <ProjectReference Include="../Patina.Contracts/Patina.Contracts.csproj"/>
    <!-- For presets, plans and delivery. Encoding is the Worker's: the Server never runs ExportRun.Run. -->
    <ProjectReference Include="../Patina.Export/Patina.Export.csproj"/>
    <ProjectReference Include="../Patina.Ipc/Patina.Ipc.csproj"/>
    <ProjectReference Include="../Patina.Jobs/Patina.Jobs.csproj"/>
    <ProjectReference Include="../Patina.Library/Patina.Library.csproj"/>
    <!-- The document, its commands and the node catalogue. No device: the Server never opens one. -->
    <ProjectReference Include="../../../external/Vixen/Tools/Vixen.TextureGraph/Vixen.TextureGraph.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Tools/Vixen.Texturing/Vixen.Texturing.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Tools/Vixen.NodeGraph/Vixen.NodeGraph.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Core/Vixen.Core.Yaml/Vixen.Core.Yaml.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../content/materials/*.vxtexgraph" LogicalName="Starter/%(Filename)"/>
    <EmbeddedResource Include="../../../content/brushes/*.ptbrush" LogicalName="Brush/%(Filename)"/>
  </ItemGroup>
</Project>
