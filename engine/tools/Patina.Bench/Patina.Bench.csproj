<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The spikes' measurements, so that the numbers in docs/adr can be run again: a seeded library generator and S6, kernels, and the viewport.</Description>
    <OutputType>Exe</OutputType>
    <AssemblyName>patina-bench</AssemblyName>
    <RootNamespace>Patina.Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- A corpus generator picks names, not keys: a seeded System.Random is the point of it. -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Patina.Library/Patina.Library.csproj"/>
    <ProjectReference Include="../../src/Patina.Viewport/Patina.Viewport.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Tools/Vixen.TextureGraph/Vixen.TextureGraph.csproj"/>
  </ItemGroup>
</Project>
