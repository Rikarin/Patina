version: 1
name: Dirt Patches
nodes:
  - id: 1
    type: Source/Noise
    x: 0
    y: 0
    values:
      Octaves: [6]
      Gain: [0.55]
    texts:
      'Basis': 'Gradient'
      '=Scale': '3f + scale * 6f'
  - id: 2
    type: Colour/Levels
    x: 300
    y: 0
    values: {}
    texts:
      '=Input Black': '0.62f - amount * 0.3f'
      '=Input White': '0.72f - amount * 0.25f + (1f - contrast) * 0.15f'
  - id: 3
    type: Source/Noise
    x: 0
    y: 300
    values:
      Octaves: [4]
      Gain: [0.6]
    texts:
      'Basis': 'Gradient'
      'Profile': 'Billow'
      '=Scale': '12f + scale * 20f'
  - id: 4
    type: Filters/Slope Blur
    x: 600
    y: 0
    values:
      Intensity: [6]
      Samples: [8]
    texts:
      'Mode': 'Blend'
  - id: 5
    type: Colour/Levels
    x: 300
    y: 300
    values:
      'Input White': [0.6]
    texts: {}
  - id: 6
    type: Colour/Blend
    x: 900
    y: 0
    values:
      Opacity: [0.6]
    texts:
      'Mode': 'Multiply'
  - id: 7
    type: Colour/Levels
    x: 1200
    y: 0
    values:
      'Input White': [0.7]
    texts: {}
  - id: 99
    type: Sub-graph/Output
    x: 1600
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Slope }
  - { fromNode: 3, fromPort: Out, toNode: 5, toPort: Input }
  - { fromNode: 4, fromPort: Out, toNode: 6, toPort: Background }
  - { fromNode: 5, fromPort: Out, toNode: 6, toPort: Foreground }
  - { fromNode: 6, fromPort: Out, toNode: 7, toPort: Input }
  - { fromNode: 7, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'Uneven patches of ground-in dirt, darker in their hearts and broken at their edges. White is dirt.'
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1' }
parameters:
  - name: scale
    label: Scale
    default: '0.5'
    summary: 'How large the features are: low is fewer, bigger ones, high is many small ones.'
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
  - name: amount
    label: Amount
    default: '0.5'
    summary: 'How much of the surface the grunge covers.'
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
  - name: contrast
    label: Contrast
    default: '0.5'
    summary: 'How hard its edges are: low is soft and faint, high is crisp.'
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
