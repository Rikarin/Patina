# One line ending everywhere: Windows checkouts would otherwise turn LF into CRLF, which leaks into generated
# artefacts such as the OpenAPI document (XML doc comments become description strings).
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.exr binary
*.hdr binary
*.glb binary
*.ktx2 binary
*.spv binary
*.dylib binary
*.so binary
*.dll binary

# No LFS rule yet, on purpose. No golden image exists, and a rule here would make every workflow's checkout need
# `lfs: true`. Add `engine/tests/**/goldens/** filter=lfs diff=lfs merge=lfs -text` with the first goldens (plan §7).
