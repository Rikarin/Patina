version: 1
name: Worn Edges
nodes:
  - { id: 1, type: Sub-graph/Input, x: -320, y: -400 }
  - { id: 2, type: Source/Mesh Map, x: -1600, y: 0, texts: { Map: curvature } }
  - { id: 3, type: Filters/Blur HQ, x: -1280, y: 0, values: { Sigma: [1] } }
  - { id: 4, type: Colour/Histogram Equalise, x: -960, y: 0 }
  - id: 5
    type: Colour/Levels
    x: -640
    y: 0
    texts:
      '=Input Black': '0.97f - width * 0.3f'
      '=Input White': '1f - width * 0.15f'
  - { id: 6, type: Colour/Levels, x: -640, y: 160, values: { Input Black: [0.501], Input White: [0.505] } }
  - { id: 7, type: Colour/Blend, x: -320, y: 0, texts: { Mode: Multiply } }
  - { id: 8, type: Source/Mesh Map, x: -1600, y: 320, texts: { Map: position } }
  - { id: 9, type: Source/Volume Noise, x: -1280, y: 320, values: { Octaves: [4], Gain: [0.65] }, texts: { Basis: Gradient, '=Scale': '40f', '=Seed': seed } }
  - id: 10
    type: Filters/Pixel Processor
    x: 0
    y: 0
    texts:
      Format: Grey
      Expression: 'float4(a.x * saturate(1f - (0.6f - b.x) * 4f * x), 0f, 0f, 1f)'
      '=X': breakup
  - id: 11
    type: Filters/Pixel Processor
    x: 320
    y: -400
    texts:
      Expression: 'float4(lerp(a.xyz, saturate(a.xyz * (1f + x) + x * 0.15f), b.x), 1f)'
      '=X': brightening
  - id: 12
    type: Filters/Pixel Processor
    x: 320
    y: -240
    texts:
      Expression: 'float4(lerp(a.xyz, a.xyz * (1f - x), b.x), 1f)'
      '=X': polish
  - { id: 99, type: Sub-graph/Output, x: 640, y: -320 }
edges:
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 6, toPort: Input }
  - { fromNode: 5, fromPort: Out, toNode: 7, toPort: Background }
  - { fromNode: 6, fromPort: Out, toNode: 7, toPort: Foreground }
  - { fromNode: 8, fromPort: Out, toNode: 9, toPort: Position }
  - { fromNode: 7, fromPort: Out, toNode: 10, toPort: A }
  - { fromNode: 9, fromPort: Out, toNode: 10, toPort: B }
  - { fromNode: 1, fromPort: baseColor, toNode: 11, toPort: A }
  - { fromNode: 10, fromPort: Out, toNode: 11, toPort: B }
  - { fromNode: 1, fromPort: roughness, toNode: 12, toPort: A }
  - { fromNode: 10, fromPort: Out, toNode: 12, toPort: B }
  - { fromNode: 11, fromPort: Out, toNode: 99, toPort: baseColor }
  - { fromNode: 12, fromPort: Out, toNode: 99, toPort: roughness }
groups: []
comments: []
interface:
  - { name: baseColor, direction: Input, kind: Image, default: [], summary: 'The surface beneath.' }
  - { name: roughness, direction: Input, kind: Image, default: [], summary: 'The roughness beneath.' }
  - { name: baseColor, direction: Output, kind: Image, default: [], summary: 'The surface, lighter where hands and tools have rubbed its edges.' }
  - { name: roughness, direction: Output, kind: Image, default: [], summary: 'The roughness, polished smoother along the rubbed edges.' }
settings:
  baseWidth: '1024'
  baseHeight: '1024'
  seed: '1'
  summary: 'Detail edge wear: the fine rubbing that lightens and polishes a model''s edges without breaking through the surface.'
  doesNotTile: 'Reads mesh maps, and an atlas has islands at its edges rather than a far side.'
parameters:
  - { name: width, label: Width, default: '0.4', summary: 'How far down the edges the rubbing reaches.', kind: Float, minimum: 0, maximum: 1, group: Wear }
  - { name: breakup, label: Breakup, default: '0.5', summary: 'How patchy the rubbing is along an edge.', kind: Float, minimum: 0, maximum: 1, group: Wear }
  - { name: seed, label: Seed, default: '0', summary: 'Another draw of the breakup. Every whole number is a different pattern.', kind: Int, minimum: 0, maximum: 100, group: Wear }
  - { name: brightening, label: Brightening, default: '0.4', summary: 'How much lighter a rubbed edge is.', kind: Float, minimum: 0, maximum: 1, group: Look }
  - { name: polish, label: Polish, default: '0.5', summary: 'How much smoother a rubbed edge is.', kind: Float, minimum: 0, maximum: 1, group: Look }
