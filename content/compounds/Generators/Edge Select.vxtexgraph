version: 1
name: Edge Select
nodes:
  - { id: 1, type: Source/Mesh Map, x: -960, y: 0, texts: { Map: curvature } }
  - { id: 2, type: Filters/Blur HQ, x: -640, y: 0, texts: { '=Sigma': 'smoothing' } }
  - { id: 3, type: Colour/Histogram Equalise, x: -320, y: 0 }
  - id: 4
    type: Colour/Levels
    x: 0
    y: 0
    texts:
      '=Input Black': '1f - amount * 0.5f - softness * 0.1f'
      '=Input White': '1f - amount * 0.5f + softness * 0.1f + 0.001f'
  - { id: 5, type: Colour/Levels, x: 0, y: 200, values: { Input Black: [0.502], Input White: [0.506] } }
  - { id: 6, type: Colour/Blend, x: 320, y: 0, texts: { Mode: Multiply } }
  - { id: 99, type: Sub-graph/Output, x: 640, y: 0 }
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 5, toPort: Input }
  - { fromNode: 4, fromPort: Out, toNode: 6, toPort: Background }
  - { fromNode: 5, fromPort: Out, toNode: 6, toPort: Foreground }
  - { fromNode: 6, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'White on the convex edges, the sharpest first, with no breakup: the start of a wear of your own.'
settings:
  baseWidth: '1024'
  baseHeight: '1024'
  seed: '1'
  summary: 'Selects the convex edges of the model by its curvature, ranked so that it reads the same on any mesh.'
  doesNotTile: 'Reads a mesh map, and an atlas has islands at its edges rather than a far side.'
parameters:
  - { name: amount, label: Amount, default: '0.3', summary: 'How much of the edges is taken, sharpest first. One takes every convex texel.', kind: Float, minimum: 0, maximum: 1, group: Edges }
  - { name: softness, label: Softness, default: '0.3', summary: 'How gently the selection fades out down the edge.', kind: Float, minimum: 0, maximum: 1, group: Edges }
  - { name: smoothing, label: Smoothing, default: '1.5', summary: 'How far the curvature is blurred first, in texels. More keeps only broad edges and drops fine detail.', kind: Float, minimum: 0, maximum: 16, group: Edges }
