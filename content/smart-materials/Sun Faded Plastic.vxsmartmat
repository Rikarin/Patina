version: 1
name: Sun Faded Plastic
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: plastic
        name: Plastic
        kind: Fill
        values:
          baseColor: [0.06, 0.2, 0.5, 1]
          roughness: [0.4, 0.4, 0.4, 1]
          metalness: [0, 0, 0, 1]
      - id: faded
        name: Faded
        kind: Fill
        blend: Copy
        values:
          baseColor: [0.32, 0.42, 0.58, 1]
          roughness: [0.55, 0.55, 0.55, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Sun Fade
      - id: scuffs
        name: Scuffs
        kind: Fill
        blend: Copy
        opacity: 0.6
        values:
          baseColor: [0.1, 0.24, 0.52, 1]
          roughness: [0.6, 0.6, 0.6, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Grunges/Scuffs
      - id: grime
        name: Grime
        kind: Fill
        blend: Copy
        opacity: 0.5
        values:
          baseColor: [0.12, 0.12, 0.11, 1]
          roughness: [0.7, 0.7, 0.7, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Cavity Select
