package Patina.Viewport

import Vixen.Shaders.Core
import Vixen.Shaders.Shading

// The viewport's surface: one directional light plus image-based lighting, in the same split-sum
// form Vixen's forward and deferred passes evaluate, on Vixen's own `Brdf` and `Ibl`. Vertices are
// already in world space, because a model is flattened once when it is read.

shader ViewportForward {
    [PerFrame] var viewProjection: mat4
    [PerFrame] var cameraPosition: float3
    [PerFrame] var lightDirection: float3
    [PerFrame] var lightColor: float3
    [PerFrame] var lightViewProjection: mat4
    [PerFrame] var shadowTexel: float
    [PerFrame] var shadowOffset: float
    [PerFrame] var shadowStrength: float
    [PerFrame] var shadowMap: Texture2D
    [PerFrame] var shadowSampler: Sampler
    [PerFrame] var environmentMipCount: float
    [PerFrame] var environmentYaw: float
    [PerFrame] var environmentSh: ShCoefficients
    [PerFrame] var environment: TextureCube
    [PerFrame] var environmentSampler: Sampler

    // What is shown, in `ViewportView`'s order: 0 lit, 1 clay, 2 unlit, then the stored values from 3 base colour to 10
    // the picture, 11 the texel density and 12 the vertex colours. A uniform rather than a permutation, because a branch
    // every pixel takes the same way costs nothing and thirteen pipelines would.
    [PerFrame] var view: float
    [PerFrame] var picture: Texture2D
    [PerFrame] var pictureSampler: Sampler

    // Which of the picture's lanes is shown: 0 its colour, then 1 red, 2 green, 3 blue and 4 alpha, each as a grey. The
    // scale multiplies the number before it is shown, so a height in metres or a position can be brought into view.
    [PerFrame] var pictureLane: float
    [PerFrame] var pictureScale: float

    // The texel density a project asks for, in texels per unit of the model, or zero for none; and the side of a map
    // where a material wears none of its own to measure.
    [PerFrame] var densityTarget: float
    [PerFrame] var densityResolution: float

    var baseColor: float3
    var metallic: float
    var roughness: float
    var normalScale: float
    var usesNormalMap: float
    var normalGreen: float

    // The side of the map this material is painted at, in texels, or zero where it wears none.
    var mapSize: float
    var baseColorMap: Texture2D
    var normalMap: Texture2D
    var roughnessMap: Texture2D
    var metallicMap: Texture2D
    var occlusionMap: Texture2D
    var emissiveMap: Texture2D
    var opacityMap: Texture2D

    // A quick mask, red over the surface where it is painted, in every view; black where a stack has none.
    var quickMaskMap: Texture2D
    var mapSampler: Sampler

    stream var worldPosition: float3
    stream var worldNormal: float3
    stream var surfaceUv: float2
    stream var worldTangent: float4
    stream var vertexColour: float4

    [VertexShader]
    [Semantic("SV_Position")]
    func Vertex(position: float3, normal: float3, texCoord: float2, tangent: float4, colour: float4): float4 {
        worldPosition = position
        worldNormal = normal
        surfaceUv = texCoord
        worldTangent = tangent
        vertexColour = colour
        return viewProjection * float4(position, 1f)
    }

    // The MikkTSpace pixel shader: the frame stays as interpolated, unnormalised, and the bitangent is made here.
    // Vixen's baker writes the exact inverse of this, so the two must only ever change together.
    func ShadedNormal(): float3 {
        if (usesNormalMap <= 0f) {
            return Math.SafeNormalize(worldNormal)
        }

        val stored = normalMap.Sample(mapSampler, surfaceUv).rgb * 2f - float3(1f, 1f, 1f)
        val t = worldTangent.xyz
        val b = cross(worldNormal, t) * (worldTangent.w < 0f ? -1f : 1f)
        return Math.SafeNormalize(t * (stored.x * normalScale) + b * (stored.y * normalScale * normalGreen) + worldNormal * stored.z)
    }

    // The forward pass's two targets: the light, and the tints laid over the finished picture after the curve (#286).
    struct Drawn {
        var light: float4
        var tint: float4
    }

    [FragmentShader]
    func Fragment(): Drawn {
        // Cut out rather than blended: a mesh draws in no depth order, and this shows where a surface stops. The opacity
        // view is the one that shows what would be cut.
        val opacity = opacityMap.Sample(mapSampler, surfaceUv).r
        if (opacity < 0.5f && (view < 8.5f || view > 9.5f)) {
            discard
        }

        var drawn: Drawn
        if (view > 1.5f) {
            drawn.light = float4(Shown(opacity), 1f)
        } else {
            drawn.light = float4(Shaded(), 1f)
        }

        drawn.tint = Masked()
        return drawn
    }

    // The light the model sends to the eye, lit or in clay.
    func Shaded(): float3 {
        val n = ShadedNormal()
        val v = Math.SafeNormalize(cameraPosition - worldPosition)
        var albedo = baseColor * baseColorMap.Sample(mapSampler, surfaceUv).rgb
        var metal = metallic * metallicMap.Sample(mapSampler, surfaceUv).b
        var perceptual = clamp(roughness * roughnessMap.Sample(mapSampler, surfaceUv).g, 0.045f, 1f)
        if (view > 0.5f) {
            // Clay: a light grey that is not metal and not shiny, so the shape is all there is to see.
            albedo = float3(0.3f, 0.3f, 0.3f)
            metal = 0f
            perceptual = 0.6f
        }

        val occlusion = saturate(occlusionMap.Sample(mapSampler, surfaceUv).r)
        val f0 = Brdf.F0FromMetalness(albedo, metal, 0.04f)
        val diffuseColor = albedo * (1f - metal)

        val emitted = view > 0.5f ? float3(0f, 0f, 0f) : emissiveMap.Sample(mapSampler, surfaceUv).rgb
        val geometric = Math.SafeNormalize(worldNormal)

        return Direct(n, v, perceptual, f0, diffuseColor, occlusion) * Sunlit(geometric) + Ambient(n, v, geometric, perceptual, f0, diffuseColor, occlusion) + emitted
    }

    // A quick mask's red, as much as it is painted, in the colours a person sees and premultiplied by its share. It is
    // laid over the finished picture after the curve, so it is the same red however bright the light or the exposure
    // (#286); the picture is kept beneath at about half, so what the mask covers still reads.
    func Masked(): float4 {
        val painted = saturate(quickMaskMap.Sample(mapSampler, surfaceUv).r) * 0.55f
        return float4(float3(0.9f, 0.08f, 0.08f) * painted, painted)
    }

    // A view of what is stored. The renderer draws these with no curve and an exposure of one, and the frame is encoded
    // as sRGB on the way out, so a measurement goes in decoded and comes out as the number in the file. Base colour and
    // emission are sampled from sRGB textures, so they are already decoded.
    func Shown(opacity: float): float3 {
        val colour = baseColor * baseColorMap.Sample(mapSampler, surfaceUv).rgb
        val emitted = emissiveMap.Sample(mapSampler, surfaceUv).rgb
        if (view < 2.5f) {
            return colour + emitted
        }

        if (view < 3.5f) {
            return colour
        }

        if (view < 4.5f) {
            return Stored(float3(roughness * roughnessMap.Sample(mapSampler, surfaceUv).g))
        }

        if (view < 5.5f) {
            return Stored(float3(metallic * metallicMap.Sample(mapSampler, surfaceUv).b))
        }

        if (view < 6.5f) {
            return Stored(usesNormalMap > 0f ? normalMap.Sample(mapSampler, surfaceUv).rgb : float3(0.5f, 0.5f, 1f))
        }

        if (view < 7.5f) {
            return Stored(float3(occlusionMap.Sample(mapSampler, surfaceUv).r))
        }

        if (view < 8.5f) {
            return emitted
        }

        if (view < 9.5f) {
            return Stored(float3(opacity))
        }

        if (view < 10.5f) {
            return Stored(Lane(picture.Sample(pictureSampler, surfaceUv)) * pictureScale)
        }

        if (view < 11.5f) {
            return Density()
        }

        // The vertex colours as the file stores them: a number per vertex, interpolated, with no light. White where the
        // file has none.
        return Stored(vertexColour.rgb)
    }

    func Stored(value: float3): float3 {
        return ColorSpaces.SrgbToLinear(saturate(value))
    }

    // One lane of the picture as a grey, or its colour.
    func Lane(texel: float4): float3 {
        if (pictureLane < 0.5f) {
            return texel.rgb
        }

        if (pictureLane < 1.5f) {
            return float3(texel.r)
        }

        if (pictureLane < 2.5f) {
            return float3(texel.g)
        }

        return pictureLane < 3.5f ? float3(texel.b) : float3(texel.a)
    }

    // Texels per unit of the model, from how much of the map and how much of the surface one pixel covers: both are
    // interpolated across a triangle in the same way, so the ratio is the triangle's own. Green is the project's
    // density, blue half of it or less and red twice or more, under a checker of 32 texels that shows stretch.
    func Density(): float3 {
        val du = ddx(surfaceUv)
        val dv = ddy(surfaceUv)
        val mapArea = abs(du.x * dv.y - du.y * dv.x)
        val surfaceArea = length(cross(ddx(worldPosition), ddy(worldPosition)))
        val side = mapSize > 0.5f ? mapSize : densityResolution
        val density = side * sqrt(mapArea / max(surfaceArea, 1e-30f))
        val ratio = densityTarget > 0f ? density / densityTarget : 1f
        val t = clamp(log2(max(ratio, 1e-6f)) * 0.5f, -1f, 1f)
        val even = float3(0.25f, 0.78f, 0.32f)
        val colour = t < 0f ? lerp(even, float3(0.22f, 0.42f, 1f), -t) : lerp(even, float3(1f, 0.26f, 0.2f), t)
        val cell = floor(surfaceUv * (side / 32f))
        val checker = frac((cell.x + cell.y) * 0.5f) < 0.25f ? 1f : 0.82f
        return ColorSpaces.SrgbToLinear(colour * checker)
    }

    // The light, and what the occlusion map says of it: a crevice sees the light through a narrower opening, so it is
    // lit only when the light comes from well above it. Filament's micro-shadowing, which leaves a surface the map calls
    // open lit as before and takes a closed one towards the cube of the cosine.
    func Direct(n: float3, v: float3, perceptual: float, f0: float3, diffuseColor: float3, occlusion: float): float3 {
        val l = Math.SafeNormalize(lightDirection)
        val angles = ShadingAngles.Of(n, v, l)
        val alpha = Brdf.ClampAlpha(Brdf.Alpha(perceptual))

        val d = Brdf.DistributionGgx(angles.NdotH, alpha)
        val visibility = Brdf.VisibilitySmithGgx(angles.NdotL, angles.NdotV, alpha)
        val fresnel = Brdf.FresnelSchlick(f0, angles.VdotH)
        val specular = fresnel * (d * visibility)
        val diffuse = diffuseColor * Const.InvPi

        val aperture = 1f / sqrt(1f - min(occlusion, 0.9999f))
        val opening = saturate(angles.NdotL * aperture)

        return (diffuse + specular) * lightColor * angles.NdotL * (opening * opening)
    }

    // The environment turns with the light, so a world direction reads the cube turned back.
    func Turned(direction: float3): float3 {
        val s = sin(environmentYaw)
        val c = cos(environmentYaw)
        return float3(direction.x * c - direction.z * s, direction.y, direction.z * c + direction.x * s)
    }

    func Lit(uv: float2, depth: float): float {
        // Reversed depth: what is nearer the light has the larger number.
        return shadowMap.SampleLevel(shadowSampler, uv, 0f).r > depth + 0.001f ? 0f : 1f
    }

    // How much of the light reaches here, from twelve taps of the light's depth on two rings, the outer one turned
    // against the inner: an edge about four texels wide rather than the stair a few taps leave. A point pushed out along
    // its normal stops a surface shadowing itself.
    func Sunlit(n: float3): float {
        val clip = lightViewProjection * float4(worldPosition + n * shadowOffset, 1f)
        val uv = float2(clip.x, -clip.y) * 0.5f + float2(0.5f, 0.5f)
        val inner = shadowTexel * 0.9f
        val outer = shadowTexel * 1.9f
        val slant = shadowTexel * 0.85f
        var lit = Lit(uv + float2(-inner, -inner), clip.z)
        lit += Lit(uv + float2(inner, -inner), clip.z)
        lit += Lit(uv + float2(-inner, inner), clip.z)
        lit += Lit(uv + float2(inner, inner), clip.z)
        lit += Lit(uv + float2(outer, 0f), clip.z)
        lit += Lit(uv + float2(-outer, 0f), clip.z)
        lit += Lit(uv + float2(0f, outer), clip.z)
        lit += Lit(uv + float2(0f, -outer), clip.z)
        lit += Lit(uv + float2(slant, slant * 2f), clip.z)
        lit += Lit(uv + float2(-slant, -slant * 2f), clip.z)
        lit += Lit(uv + float2(slant * 2f, -slant), clip.z)
        lit += Lit(uv + float2(-slant * 2f, slant), clip.z)
        return 1f - (1f - lit / 12f) * shadowStrength
    }

    // The environment's light. Occlusion darkens the diffuse as the map says, and the reflection as Lagarde's fit of the
    // cone a glossy lobe leaves through the opening says, so a smooth surface keeps more of its reflection than of its
    // diffuse. A reflection a normal map turns below the surface is taken away, since the surface would hide it.
    func Ambient(n: float3, v: float3, geometric: float3, perceptual: float, f0: float3, diffuseColor: float3, occlusion: float): float3 {
        val NdotV = saturate(dot(n, v))
        val dfg = Ibl.EnvironmentDfg(NdotV, perceptual)
        val lod = Ibl.SpecularLod(perceptual, environmentMipCount)
        val reflected = reflect(-v, n)
        val prefiltered = environment.SampleLevel(environmentSampler, Turned(reflected), lod).rgb
        val irradiance = Ibl.IrradianceSh9(Turned(n), environmentSh)
        val glossy = saturate(pow(NdotV + occlusion, exp2(-16f * Brdf.Alpha(perceptual) - 1f)) - 1f + occlusion)
        val horizon = SpecularModels.HorizonOcclusion(reflected, geometric)

        return Ibl.Specular(prefiltered, f0, dfg, glossy * horizon) + Ibl.Diffuse(irradiance, diffuseColor, occlusion)
    }
}
