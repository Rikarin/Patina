version: 1
name: Mould Spots
nodes:
  - { id: 1, type: Source/Shape, x: 0, y: 0, values: { Falloff: [0.5], Scale: [0.9] }, texts: { Kind: Disc } }
  - id: 2
    type: Placement/Splatter
    x: 300
    y: 0
    values: { Scale Jitter: [0.9], Colour Jitter: [0.5] }
    texts: { Accumulation: Max, '=Count': '200f + amount * 600f', '=Scale': '0.05f - scale * 0.03f' }
  - { id: 3, type: Source/Noise, x: 0, y: 300, values: { Octaves: [4], Gain: [0.55] }, texts: { Basis: Gradient, '=Scale': '3f' } }
  - id: 4
    type: Filters/Pixel Processor
    x: 600
    y: 0
    texts:
      Format: Grey
      Expression: 'float4(saturate(a.x * smoothstep(x, x + 0.12f, b.x) + smoothstep(x + 0.1f, x + 0.3f, b.x) * 0.25f), 0f, 0f, 1f)'
      '=X': '0.62f - amount * 0.3f'
  - { id: 99, type: Sub-graph/Output, x: 900, y: 0 }
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Pattern }
  - { fromNode: 2, fromPort: Out, toNode: 4, toPort: A }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: B }
  - { fromNode: 4, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - { name: Out, direction: Output, kind: Image, default: [], summary: 'Colonies of small round spots gathered in damp patches, with a faint bloom between them. White is mould.' }
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1' }
parameters:
  - { name: scale, label: Scale, default: '0.5', summary: 'How large the features are: low is fewer, bigger ones, high is many small ones.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
  - { name: amount, label: Amount, default: '0.5', summary: 'How much of the surface the grunge covers.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
