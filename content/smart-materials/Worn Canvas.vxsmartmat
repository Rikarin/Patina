version: 1
name: Worn Canvas
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: canvas
        name: Canvas
        kind: Fill
        values:
          baseColor: [0.55, 0.47, 0.33, 1]
          roughness: [0.9, 0.9, 0.9, 1]
          metalness: [0, 0, 0, 1]
      - id: fibres
        name: Fibres
        kind: Fill
        blend: Copy
        opacity: 0.5
        values:
          baseColor: [0.6, 0.52, 0.37, 1]
          roughness: [0.92, 0.92, 0.92, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Grunges/Fibre Tangle
      - id: frayed
        name: Frayed Edges
        kind: Fill
        blend: Copy
        values:
          baseColor: [0.7, 0.64, 0.5, 1]
          roughness: [0.95, 0.95, 0.95, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Frayed Edges
      - id: stains
        name: Water Stains
        kind: Fill
        blend: Copy
        opacity: 0.6
        values:
          baseColor: [0.42, 0.35, 0.24, 1]
          roughness: [0.85, 0.85, 0.85, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Grunges/Water Stains
      - id: dirt
        name: Dirt
        kind: Fill
        blend: Copy
        opacity: 0.7
        values:
          baseColor: [0.25, 0.21, 0.15, 1]
          roughness: [0.95, 0.95, 0.95, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Cavity Select
