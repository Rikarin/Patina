version: 1
name: Dust Splash
nodes:
  - id: 1
    type: Source/Shape
    x: 0
    y: 0
    values:
      Falloff: [0.5]
      Scale: [0.9]
    texts:
      'Kind': 'Disc'
  - id: 2
    type: Placement/Splatter
    x: 300
    y: 0
    values:
      'Scale Jitter': [0.8]
      'Rotation Jitter': [6.2831855]
    texts:
      'Accumulation': 'Max'
      '=Count': '20f + amount * 80f'
      '=Scale': '0.22f - scale * 0.12f'
  - id: 3
    type: Source/Noise
    x: 0
    y: 300
    values:
      Octaves: [5]
      Gain: [0.6]
    texts:
      'Basis': 'Gradient'
      '=Scale': '6f + scale * 10f'
  - id: 4
    type: Filters/Warp
    x: 600
    y: 0
    values:
      Intensity: [4]
    texts: {}
  - id: 5
    type: Filters/Slope Blur
    x: 900
    y: 0
    values:
      Intensity: [3]
      Samples: [8]
    texts:
      'Mode': 'Blend'
  - id: 6
    type: Colour/Levels
    x: 1200
    y: 0
    values:
      'Input Black': [0.08]
      'Input White': [0.6]
    texts: {}
  - id: 99
    type: Sub-graph/Output
    x: 1600
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Pattern }
  - { fromNode: 2, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Warp }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: Input }
  - { fromNode: 3, fromPort: Out, toNode: 5, toPort: Slope }
  - { fromNode: 5, fromPort: Out, toNode: 6, toPort: Input }
  - { fromNode: 6, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'Soft blotches of thrown dust or dried splashes, each ragged at its edge. White is dust.'
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1' }
parameters:
  - name: scale
    label: Scale
    default: '0.5'
    summary: 'How large the features are: low is fewer, bigger ones, high is many small ones.'
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
  - name: amount
    label: Amount
    default: '0.5'
    summary: 'How much of the surface the grunge covers.'
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
