version: 1
name: Scuffs
nodes:
  - id: 1
    type: Source/Shape
    x: 0
    y: 0
    values:
      Inner: [0.14]
      Falloff: [0.2]
      Scale: [0.95]
    texts:
      'Kind': 'Capsule'
  - id: 2
    type: Placement/Splatter
    x: 300
    y: 0
    values:
      'Scale Jitter': [0.7]
      'Rotation Jitter': [6.2831855]
      'Colour Jitter': [0.4]
    texts:
      'Accumulation': 'Max'
      '=Count': '60f + amount * 300f'
      '=Scale': '0.16f - scale * 0.08f'
  - id: 3
    type: Source/Noise
    x: 0
    y: 300
    values:
      Octaves: [5]
      Gain: [0.6]
    texts:
      'Basis': 'Gradient'
      '=Scale': '5f'
  - id: 4
    type: Colour/Levels
    x: 300
    y: 300
    values:
      'Input Black': [0.25]
      'Input White': [0.6]
    texts: {}
  - id: 5
    type: Colour/Blend
    x: 600
    y: 0
    values: {}
    texts:
      'Mode': 'Multiply'
  - id: 99
    type: Sub-graph/Output
    x: 1600
    y: 0
    values: {}
    texts: {}
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Pattern }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 5, toPort: Background }
  - { fromNode: 4, fromPort: Out, toNode: 5, toPort: Foreground }
  - { fromNode: 5, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - name: Out
    direction: Output
    kind: Image
    default: []
    summary: 'Short scrapes in every direction, as shoes and handling leave on a floor or a case. White is a scuff.'
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1' }
parameters:
  - name: scale
    label: Scale
    default: '0.5'
    summary: 'How large the features are: low is fewer, bigger ones, high is many small ones.'
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
  - name: amount
    label: Amount
    default: '0.5'
    summary: 'How much of the surface the grunge covers.'
    kind: Float
    minimum: 0
    maximum: 1
    group: Grunge
