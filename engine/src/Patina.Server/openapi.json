{
  "openapi": "3.1.1",
  "info": {
    "title": "patina-server | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/api/v1/system": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "The Server\u0027s version, its library, the machine it runs on and the state of its Worker.",
        "operationId": "GetSystem",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/viewport": {
      "get": {
        "tags": [
          "Viewport"
        ],
        "summary": "The viewport: its mesh, camera and size. Frames come over the /ws/viewport WebSocket.",
        "operationId": "GetViewport",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewportState"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/viewport/mesh": {
      "put": {
        "tags": [
          "Viewport"
        ],
        "summary": "Shows a mesh file in the viewport.",
        "operationId": "SetViewportMesh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ViewportMeshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewportState"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/viewport/camera": {
      "put": {
        "tags": [
          "Viewport"
        ],
        "summary": "Moves the viewport\u0027s camera.",
        "operationId": "SetViewportCamera",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ViewportCameraState"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewportState"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HostInfo": {
        "required": [
          "os",
          "architecture",
          "runtime"
        ],
        "type": "object",
        "properties": {
          "os": {
            "type": "string",
            "description": "The operating system\u0027s description."
          },
          "architecture": {
            "type": "string",
            "description": "The process architecture, such as \u0060Arm64\u0060."
          },
          "runtime": {
            "type": "string",
            "description": "The .NET runtime\u0027s description."
          }
        },
        "description": "The machine and runtime a process runs on."
      },
      "SystemInfo": {
        "required": [
          "version",
          "apiVersion",
          "host",
          "worker"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "The Server\u0027s release version."
          },
          "apiVersion": {
            "type": "integer",
            "description": "The major version of the REST API; it is the \u0060v1\u0060 in the URL.",
            "format": "int32"
          },
          "library": {
            "type": [
              "null",
              "string"
            ],
            "description": "The library this Server owns, or null when it was started without one."
          },
          "host": {
            "description": "The machine and runtime the Server runs on.",
            "$ref": "#/components/schemas/HostInfo"
          },
          "worker": {
            "description": "The Worker process as the Server sees it.",
            "$ref": "#/components/schemas/WorkerStatus"
          }
        },
        "description": "The reply to \u0060GET /api/v1/system\u0060."
      },
      "ViewportCameraState": {
        "required": [
          "yaw",
          "pitch",
          "distance"
        ],
        "type": "object",
        "properties": {
          "yaw": {
            "type": "number",
            "description": "Radians around the up axis.",
            "format": "double"
          },
          "pitch": {
            "type": "number",
            "description": "Radians above the horizon.",
            "format": "double"
          },
          "distance": {
            "type": "number",
            "description": "From the model\u0027s centre, in bounding radii.",
            "format": "double"
          }
        },
        "description": "The viewport\u0027s camera: an orbit around the model."
      },
      "ViewportMeshRequest": {
        "required": [
          "path"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The file\u0027s path, on the Server\u0027s machine."
          }
        },
        "description": "Asks the viewport to show a mesh."
      },
      "ViewportState": {
        "required": [
          "camera",
          "width",
          "height",
          "renderScale",
          "frames"
        ],
        "type": "object",
        "properties": {
          "mesh": {
            "type": [
              "null",
              "string"
            ],
            "description": "The mesh\u0027s path, or null when none is open."
          },
          "camera": {
            "description": "The camera.",
            "$ref": "#/components/schemas/ViewportCameraState"
          },
          "width": {
            "type": "integer",
            "description": "The size clients asked for, in pixels.",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "description": "The size clients asked for, in pixels.",
            "format": "int32"
          },
          "renderScale": {
            "type": "number",
            "description": "The share of that size frames are rendered at, which drops while a client cannot keep up.",
            "format": "double"
          },
          "frames": {
            "type": "integer",
            "description": "How many frames this Server has published.",
            "format": "int64"
          },
          "error": {
            "type": [
              "null",
              "string"
            ],
            "description": "Why the last command failed, or null."
          }
        },
        "description": "The reply to \u0060GET /api/v1/viewport\u0060. The Server owns all of this; a Worker can die without losing it."
      },
      "WorkerStatus": {
        "required": [
          "connected"
        ],
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean",
            "description": "Whether a Worker is connected and answering."
          },
          "version": {
            "type": [
              "null",
              "string"
            ],
            "description": "The Worker\u0027s release version, from its hello."
          },
          "processId": {
            "type": [
              "null",
              "integer"
            ],
            "description": "The Worker\u0027s process id, from its hello.",
            "format": "int32"
          },
          "uptimeSeconds": {
            "type": [
              "null",
              "number"
            ],
            "description": "How long the Worker has run, from its last health reply.",
            "format": "double"
          },
          "workingSetBytes": {
            "type": [
              "null",
              "integer"
            ],
            "description": "The Worker\u0027s memory, from its last health reply.",
            "format": "int64"
          }
        },
        "description": "The Worker as the Server sees it. All but \u0060Connected\u0060 are null while there is none."
      }
    }
  },
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Viewport"
    }
  ]
}
