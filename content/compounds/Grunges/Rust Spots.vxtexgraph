version: 1
name: Rust Spots
nodes:
  - { id: 1, type: Source/Noise, x: 0, y: 0, values: { Octaves: [5], Gain: [0.6] }, texts: { Basis: Gradient, '=Scale': '3f + scale * 9f' } }
  - { id: 2, type: Source/Noise, x: 0, y: 300, values: { Octaves: [2], Gain: [0.5] }, texts: { Basis: Worley, '=Scale': '24f + scale * 40f' } }
  - id: 3
    type: Filters/Pixel Processor
    x: 300
    y: 0
    texts:
      Format: Grey
      Expression: 'float4(smoothstep(x, x + 0.02f + (1f - y) * 0.15f, a.x + (0.25f - b.x) * 0.3f), 0f, 0f, 1f)'
      '=X': '0.66f - amount * 0.3f'
      '=Y': contrast
  - { id: 99, type: Sub-graph/Output, x: 600, y: 0 }
edges:
  - { fromNode: 1, fromPort: Out, toNode: 3, toPort: A }
  - { fromNode: 2, fromPort: Out, toNode: 3, toPort: B }
  - { fromNode: 3, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - { name: Out, direction: Output, kind: Image, default: [], summary: 'Blotches of rust breaking through a coating, with ragged, pitted rims. White is rust.' }
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1' }
parameters:
  - { name: scale, label: Scale, default: '0.5', summary: 'How large the features are: low is fewer, bigger ones, high is many small ones.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
  - { name: amount, label: Amount, default: '0.5', summary: 'How much of the surface the grunge covers.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
  - { name: contrast, label: Contrast, default: '0.5', summary: 'How hard its edges are: low is soft and faint, high is crisp.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
