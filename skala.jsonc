{
  // Skala (https://github.com/Rikarin/Skala): the C# formatter, linter and quality gate, run over the engine. The tool
  // is pinned in dotnet-tools.json; CI runs it in .github/workflows/skala.yml.
  //
  // What it covers: every gate runs on the path `engine`, here and in CI. `external/` is outside that path on purpose:
  // the Vixen submodule runs its own gates in its own repository, so Patina neither reports nor baselines its findings.
  //
  // The rules: every rule runs at Skala's default severity and threshold unless .editorconfig (the only place Skala
  // reads them from) switches it off or re-tunes it, and every such line there says why the rule does not fit Patina. A
  // rule that fits is fixed to zero findings. Suppressing one finding in place (#pragma with the reason on the line
  // above) is for a finding that is wrong for that code, never for one that is merely inconvenient.
  //
  // The baseline (.skala/baseline.sarif): it starts empty and it only shrinks, so an entry needs a deliberate decision.
  // The one honest use is SK7020 (duplicated block), a whole-repository pass that honours no #pragma, [SuppressMessage]
  // or per-path severity, so a deliberate clone cannot be suppressed where it is. CI writes the baseline's size, by
  // rule, to the run's summary and fails when it grows against the base branch. New findings are fixed, or their rule
  // is switched off in .editorconfig with the reason; regenerating the baseline to absorb them is not the way.
  "gates": {
    // What a developer runs (`dotnet skala verify engine`): errors stop you, nothing else does, and what the
    // committed baseline has accepted is not reported as something to do.
    "local": {
      "baseline": ".skala/baseline.sarif",
      "maxSeverity": "error"
    },

    // A pull request: only the lines the branch touched have to be clean, and formatted.
    "pr": {
      "since": "origin/master",
      "newIssues": 0,
      "maxSeverity": "warning",
      "formatting": "clean"
    },

    // Master: nothing outside the committed baseline at warning or above, and the tree formatted.
    "ci": {
      "baseline": ".skala/baseline.sarif",
      "newIssues": 0,
      "maxSeverity": "warning",
      "formatting": "clean"
    }
  }
}
