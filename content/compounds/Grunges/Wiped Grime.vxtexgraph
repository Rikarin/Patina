version: 1
name: Wiped Grime
nodes:
  - { id: 1, type: Source/Noise, x: 0, y: 0, values: { Octaves: [5], Gain: [0.55] }, texts: { Basis: Gradient, '=Scale': '6f + scale * 12f' } }
  - { id: 2, type: Filters/Directional Blur, x: 300, y: 0, values: { Angle: [0], Length: [24] } }
  - { id: 3, type: Source/Noise, x: 0, y: 300, values: { Octaves: [3], Gain: [0.5], Scale X: [0.5] }, texts: { Basis: Gradient, '=Scale': '4f' } }
  - id: 4
    type: Filters/Pixel Processor
    x: 600
    y: 0
    texts:
      Format: Grey
      Expression: 'float4(smoothstep(x - 0.18f * (1.1f - y), x + 0.18f * (1.1f - y), a.x * 0.7f + b.x * 0.3f), 0f, 0f, 1f)'
      '=X': '0.62f - amount * 0.3f'
      '=Y': contrast
  - { id: 99, type: Sub-graph/Output, x: 900, y: 0 }
edges:
  - { fromNode: 1, fromPort: Out, toNode: 2, toPort: Input }
  - { fromNode: 2, fromPort: Out, toNode: 4, toPort: A }
  - { fromNode: 3, fromPort: Out, toNode: 4, toPort: B }
  - { fromNode: 4, fromPort: Out, toNode: 99, toPort: Out }
groups: []
comments: []
interface:
  - { name: Out, direction: Output, kind: Image, default: [], summary: 'Grime smeared sideways by a cloth, in long soft bands with clean gaps between. White is grime.' }
settings: { baseWidth: '1024', baseHeight: '1024', seed: '1' }
parameters:
  - { name: scale, label: Scale, default: '0.5', summary: 'How large the features are: low is fewer, bigger ones, high is many small ones.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
  - { name: amount, label: Amount, default: '0.5', summary: 'How much of the surface the grunge covers.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
  - { name: contrast, label: Contrast, default: '0.5', summary: 'How hard its edges are: low is soft and faint, high is crisp.', kind: Float, minimum: 0, maximum: 1, group: Grunge }
