<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The process that will own the GPU device and native parsers. Stateless: it executes what the Server asks and can be restarted at any time. It renders the viewport, evaluates texture graphs and runs bakes.</Description>
    <OutputType>Exe</OutputType>
    <AssemblyName>patina-worker</AssemblyName>
    <RootNamespace>Patina.Worker</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Patina.Contracts/Patina.Contracts.csproj"/>
    <ProjectReference Include="../Patina.Export/Patina.Export.csproj"/>
    <ProjectReference Include="../Patina.Ipc/Patina.Ipc.csproj"/>
    <ProjectReference Include="../Patina.Viewport/Patina.Viewport.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Tools/Vixen.TextureGraph/Vixen.TextureGraph.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Tools/Vixen.NodeGraph/Vixen.NodeGraph.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Tools/Vixen.Interchange/Vixen.Interchange.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Platform/Vixen.Graphics.Vulkan/Vixen.Graphics.Vulkan.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Core/Vixen.Core.Imaging/Vixen.Core.Imaging.csproj"/>
    <ProjectReference Include="../../../external/Vixen/Core/Vixen.Core.Yaml/Vixen.Core.Yaml.csproj"/>
  </ItemGroup>
</Project>
