version: 1
name: Muddy Rubber
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: rubber
        name: Rubber
        kind: Fill
        values:
          baseColor: [0.04, 0.04, 0.04, 1]
          roughness: [0.7, 0.7, 0.7, 1]
          metalness: [0, 0, 0, 1]
      - id: scuffs
        name: Scuffs
        kind: Fill
        blend: Copy
        opacity: 0.7
        values:
          baseColor: [0.09, 0.09, 0.09, 1]
          roughness: [0.85, 0.85, 0.85, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Grunges/Scuffs
      - id: mud
        name: Mud
        kind: Fill
        blend: Copy
        values:
          baseColor: [0.24, 0.18, 0.11, 1]
          roughness: [0.9, 0.9, 0.9, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Ground Grime
      - id: splashes
        name: Splashes
        kind: Fill
        blend: Copy
        opacity: 0.8
        values:
          baseColor: [0.3, 0.24, 0.16, 1]
          roughness: [0.88, 0.88, 0.88, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Grunges/Dust Splash
