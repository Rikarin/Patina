version: 1
name: Mossy Stone
baseWidth: 1024
baseHeight: 1024
sets:
  - name: Material
    channels:
      - usage: baseColor
        default: [0.5, 0.5, 0.5, 1]
      - usage: roughness
        default: [0.5, 0.5, 0.5, 1]
      - usage: metalness
        default: [0, 0, 0, 1]
    layers:
      - id: stone
        name: Stone
        kind: Fill
        values:
          baseColor: [0.42, 0.41, 0.38, 1]
          roughness: [0.85, 0.85, 0.85, 1]
          metalness: [0, 0, 0, 1]
      - id: pores
        name: Pores
        kind: Fill
        blend: Copy
        opacity: 0.6
        values:
          baseColor: [0.33, 0.32, 0.3, 1]
          roughness: [0.9, 0.9, 0.9, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Grunges/Concrete Pores
      - id: dirt
        name: Dirt
        kind: Fill
        blend: Copy
        opacity: 0.7
        values:
          baseColor: [0.2, 0.18, 0.15, 1]
          roughness: [0.92, 0.92, 0.92, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Cavity Select
      - id: moss
        name: Moss
        kind: Fill
        blend: Copy
        values:
          baseColor: [0.2, 0.32, 0.08, 1]
          roughness: [0.95, 0.95, 0.95, 1]
          metalness: [0, 0, 0, 1]
        mask:
          source: Generator
          generator: Generators/Moss
